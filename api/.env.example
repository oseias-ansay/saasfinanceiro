# ---------------------------------------------------------------------
# API Financeira — copie para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Supabase self-hosted -------------------------------------------------
# Em produção, dentro da mesma rede Docker, use http://kong:8000
SUPABASE_URL=https://api.oseiasansay.com.br
SUPABASE_ANON_KEY=cole_a_anon_key_do_env_do_supabase
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_do_env_do_supabase

# Segredo compartilhado com o n8n. Gere com: openssl rand -hex 32
N8N_WEBHOOK_SECRET=troque_por_um_hex_de_64_caracteres

# Origens liberadas no CORS (separadas por vírgula)
# Em produção, o domínio do front (Etapa 4). Localhost fica só em dev.
CORS_ORIGINS=http://localhost:5173,https://financeiro.businesstriage.com.br

# Evolution API (WhatsApp) ---------------------------------------------
# Endereço INTERNO do Docker. A porta pública está fechada de propósito,
# e um contêiner chamando o domínio público do próprio host não completa
# a volta.
EVOLUTION_URL=http://evolution:8080
EVOLUTION_APIKEY=cole_a_apikey_da_evolution

# Segredo que a Evolution manda no cabeçalho x-evolution-token do
# webhook. Vazio significa "usa o N8N_WEBHOOK_SECRET" — nunca significa
# "sem verificação". Gere com: openssl rand -hex 32
EVOLUTION_WEBHOOK_TOKEN=

# Vigia (monitoramento) ------------------------------------------------
# Para onde vai o alarme quando um processo automático para. Telefone em
# dígitos, com o 55 na frente. Vazio NÃO desliga a vigilância — o alarme
# passa a cair só no log, que é pior que receber e melhor que achar que
# está protegido sem estar.
MONITOR_WHATSAPP=5541999999999
MONITOR_INSTANCIA=wa_ultimo

# Liga o relógio interno. Deixe false em desenvolvimento: cada `npm run
# dev` na sua máquina mandaria alarme de verdade para o seu celular.
MONITOR_ATIVO=true
MONITOR_INTERVALO_MIN=10

# Hora local do pulso diário de "tudo certo". A ausência dele é o que
# avisa que o próprio vigia morreu.
MONITOR_HORA_PULSO=7

# Claude (análise dos diagnósticos) ------------------------------------
# Sem a chave, a geração de análise falha alto em vez de produzir
# relatório pela metade.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_MS=120000

# SMTP -----------------------------------------------------------------
# As MESMAS credenciais que o n8n já usava nos fluxos de entrada. Não é
# servidor novo nem remetente novo, então SPF, DKIM e reputação seguem
# iguais e a migração não mexe em entregabilidade.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=Business Triage <contato@businesstriage.com.br>
EMAIL_INTERNO=contato@businesstriage.com.br

# Disjuntor de gasto com a IA -------------------------------------------
# Quantas análises por dia, no máximo. NÃO é cota: é proteção contra
# defeito nosso e contra um dia muito fora da curva. Deve ficar bem acima
# do movimento normal — teto apertado transforma um bom dia de campanha
# em prospect recusado.
IA_LIMITE_DIARIO=60
